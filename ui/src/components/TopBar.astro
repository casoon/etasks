---
---

<header class="h-[56px] flex items-center justify-between px-6 border-b border-border bg-surface flex-shrink-0">
  <div id="topbar-date" class="text-[15px] font-semibold text-primary"></div>

  <div class="flex items-center gap-3">
    <div class="flex bg-bg rounded-lg p-0.5 gap-0.5" role="group" aria-label="Ansicht">
      <button
        class="view-btn px-3 py-1 rounded-md text-[13px] font-medium text-secondary transition-colors hover:text-primary is-active"
        data-view="day"
      >Tag</button>
      <button
        class="view-btn px-3 py-1 rounded-md text-[13px] font-medium text-secondary transition-colors hover:text-primary"
        data-view="board"
      >Board</button>
    </div>
  </div>
</header>

<script>
  import { $viewMode } from '../stores/uiStore';
  import { formatDate } from '../domain/dateUtils';
  import { $activeDate } from '../stores/taskStore';

  // Update date display
  function updateDate() {
    const el = document.getElementById('topbar-date');
    if (el) el.textContent = formatDate($activeDate.get());
  }
  updateDate();
  $activeDate.subscribe(updateDate);

  // View switch
  document.querySelectorAll('[data-view]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const view = (btn as HTMLElement).dataset.view as 'day' | 'board';
      $viewMode.set(view);
      document.querySelectorAll('[data-view]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });
</script>

<style>
  .view-btn.is-active {
    background: var(--color-surface);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-card);
  }
</style>
