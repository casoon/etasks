---
const navItems = [
  { id: 'today', label: 'Heute', icon: '◉' },
  { id: 'planning-daily', label: 'Tagesplanung', icon: '☀' },
  { id: 'planning-weekly', label: 'Wochenplanung', icon: '◎' },
  { id: 'projects', label: 'Projekte', icon: '▦' },
  { id: 'time-tracking', label: 'Zeiterfassung', icon: '⏲' },
  { id: 'clients', label: 'Abrechnung', icon: '€' },
  { id: 'focus', label: 'Fokus', icon: '⏱' },
];
---

<nav class="sidebar">
  <div class="sidebar-logo">
    <span class="logo-mark">e</span>
    <span class="logo-text">tasks</span>
  </div>

  <ul class="nav-list" role="list">
    {navItems.map((item) => (
      <li>
        <button class="nav-item" data-nav={item.id} aria-label={item.label}>
          <span class="nav-icon" aria-hidden="true">{item.icon}</span>
          <span class="nav-label">{item.label}</span>
        </button>
      </li>
    ))}
  </ul>

  <div class="sidebar-footer">
    <button class="nav-item nav-item--action" data-action="export" aria-label="Daten exportieren">
      <span class="nav-icon" aria-hidden="true">↓</span>
      <span class="nav-label">Exportieren</span>
    </button>
    <button class="nav-item nav-item--shutdown" data-action="shutdown" aria-label="Tagesabschluss">
      <span class="nav-icon" aria-hidden="true">↙</span>
      <span class="nav-label">Abschluss</span>
    </button>
  </div>
</nav>

<script>
  import { $navItem, $showShutdown } from '../stores/uiStore';
  import { exportToFile } from '../lib/exportService';

  document.querySelectorAll('[data-nav]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const nav = (btn as HTMLElement).dataset.nav as any;
      $navItem.set(nav);
      document.querySelectorAll('[data-nav]').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });

  document.querySelector('[data-action="shutdown"]')?.addEventListener('click', () => {
    $showShutdown.set(true);
  });

  document.querySelector('[data-action="export"]')?.addEventListener('click', () => {
    exportToFile();
  });

  const initial = $navItem.get();
  document.querySelector(`[data-nav="${initial}"]`)?.classList.add('is-active');
</script>

<style>
  .sidebar {
    width: var(--sidebar-width);
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-3);
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .sidebar-logo {
    display: flex;
    align-items: baseline;
    gap: 2px;
    padding: var(--space-2) var(--space-2);
    user-select: none;
  }

  .logo-mark {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .logo-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    transition: background var(--transition), color var(--transition);
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
  }

  .nav-item:hover { background: var(--color-bg); color: var(--color-text-primary); }
  .nav-item.is-active { background: var(--color-accent-subtle); color: var(--color-accent); }

  .nav-icon {
    font-size: 14px;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
  }

  .nav-label { flex: 1; overflow: hidden; text-overflow: ellipsis; }

  .sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item--shutdown, .nav-item--action {
    color: var(--color-text-muted);
    font-size: 12px;
  }
</style>
