---
const navItems = [
    { id: "today", label: "Heute", icon: "◉" },
    { id: "planning-daily", label: "Tagesplanung", icon: "☀" },
    { id: "planning-weekly", label: "Wochenplanung", icon: "◎" },
    { id: "projects", label: "Projekte", icon: "▦" },
    { id: "time-tracking", label: "Zeiterfassung", icon: "⏲" },
    { id: "clients", label: "Abrechnung", icon: "€" },
    { id: "focus", label: "Fokus", icon: "⏱" },
    { id: "settings", label: "Einstellungen", icon: "⚙" },
];
---

<nav
    class="w-[200px] bg-surface border-r border-border flex flex-col py-4 px-3 gap-4 flex-shrink-0"
>
    <div class="flex items-baseline gap-0.5 px-2 py-2 select-none">
        <span class="text-xl font-bold text-accent leading-none">e</span>
        <span class="text-base font-semibold text-primary">tasks</span>
    </div>

    <div class="relative px-2" id="tenant-switcher-container">
        <button
            id="tenant-name-btn"
            class="flex items-center gap-1.5 w-full px-2 py-1.5 rounded-lg text-[12px] font-medium text-secondary hover:bg-bg hover:text-primary transition-colors text-left"
        >
            <span id="tenant-name-text" class="flex-1 truncate">–</span>
            <span class="text-[10px] text-muted flex-shrink-0">▾</span>
        </button>
        <div
            id="tenant-dropdown"
            class="hidden absolute left-0 right-0 top-full mt-1 z-50 bg-surface border border-border rounded-lg shadow-lg overflow-hidden"
        >
            <div id="tenant-list" class="flex flex-col"></div>
            <div class="border-t border-border">
                <button
                    id="tenant-add-btn"
                    class="flex items-center gap-2 w-full px-3 py-2 text-[12px] text-secondary hover:bg-bg hover:text-primary transition-colors text-left"
                >
                    <span>+</span> Neuen anlegen
                </button>
            </div>
        </div>
    </div>

    <ul class="list-none flex flex-col gap-0.5 flex-1" role="list">
        {
            navItems.map((item) => (
                <li>
                    <button
                        class="nav-item flex items-center gap-3 w-full px-3 py-2 rounded-lg text-secondary text-[13px] font-medium transition-colors text-left whitespace-nowrap overflow-hidden hover:bg-bg hover:text-primary"
                        data-nav={item.id}
                        aria-label={item.label}
                    >
                        <span
                            class="text-sm w-[18px] text-center flex-shrink-0"
                            aria-hidden="true"
                        >
                            {item.icon}
                        </span>
                        <span class="flex-1 overflow-hidden text-ellipsis">
                            {item.label}
                        </span>
                    </button>
                </li>
            ))
        }
    </ul>

    <div class="flex flex-col gap-0.5">
        <button
            class="nav-item flex items-center gap-3 w-full px-3 py-2 rounded-lg text-muted text-xs font-medium transition-colors text-left whitespace-nowrap overflow-hidden hover:bg-bg hover:text-primary"
            data-action="export"
            aria-label="Daten exportieren"
        >
            <span
                class="text-sm w-[18px] text-center flex-shrink-0"
                aria-hidden="true">↓</span
            >
            <span class="flex-1 overflow-hidden text-ellipsis">Exportieren</span
            >
        </button>
        <button
            class="nav-item flex items-center gap-3 w-full px-3 py-2 rounded-lg text-muted text-xs font-medium transition-colors text-left whitespace-nowrap overflow-hidden hover:bg-bg hover:text-primary"
            data-action="shutdown"
            aria-label="Tagesabschluss"
        >
            <span
                class="text-sm w-[18px] text-center flex-shrink-0"
                aria-hidden="true">↙</span
            >
            <span class="flex-1 overflow-hidden text-ellipsis">Abschluss</span>
        </button>
    </div>
</nav>

<script>
    import { $navItem, $showShutdown } from "../stores/uiStore";
    import { $appConfig } from "../stores/configStore";
    import { exportToFile } from "../lib/exportService";
    import { activateTenant } from "../lib/appBootstrap";

    function updateTenantSwitcher(config: any) {
        const nameEl = document.getElementById("tenant-name-text");
        if (!nameEl || !config) return;
        const active = config.tenants?.find(
            (t: any) => t.path === config.active_tenant,
        );
        nameEl.textContent = active?.displayName ?? active?.name ?? "–";

        const list = document.getElementById("tenant-list");
        if (!list) return;
        list.innerHTML = "";
        (config.tenants ?? []).forEach((t: any) => {
            const btn = document.createElement("button");
            btn.className = `flex items-center gap-2 w-full px-3 py-2 text-[12px] transition-colors text-left ${t.path === config.active_tenant ? "text-accent font-semibold bg-accent/5" : "text-secondary hover:bg-bg hover:text-primary"}`;
            btn.textContent =
                t.displayName ?? t.name ?? t.path.split("/").pop();
            if (t.path !== config.active_tenant) {
                btn.addEventListener("click", async () => {
                    closeDropdown();
                    await activateTenant(t.path);
                    $navItem.set("today");
                    document
                        .querySelectorAll("[data-nav]")
                        .forEach((b) => b.classList.remove("is-active"));
                    document
                        .querySelector('[data-nav="today"]')
                        ?.classList.add("is-active");
                });
            }
            list.appendChild(btn);
        });
    }

    $appConfig.subscribe(updateTenantSwitcher);

    const tenantBtn = document.getElementById("tenant-name-btn");
    const dropdown = document.getElementById("tenant-dropdown");

    function closeDropdown() {
        dropdown?.classList.add("hidden");
    }

    tenantBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        dropdown?.classList.toggle("hidden");
    });

    document.addEventListener("click", closeDropdown);

    document.getElementById("tenant-add-btn")?.addEventListener("click", () => {
        closeDropdown();
        $navItem.set("settings" as any);
        document
            .querySelectorAll("[data-nav]")
            .forEach((b) => b.classList.remove("is-active"));
        document
            .querySelector('[data-nav="settings"]')
            ?.classList.add("is-active");
    });

    document.querySelectorAll("[data-nav]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const nav = (btn as HTMLElement).dataset.nav as any;
            $navItem.set(nav);
            document
                .querySelectorAll("[data-nav]")
                .forEach((b) => b.classList.remove("is-active"));
            btn.classList.add("is-active");
        });
    });

    document
        .querySelector('[data-action="shutdown"]')
        ?.addEventListener("click", () => {
            $showShutdown.set(true);
        });

    document
        .querySelector('[data-action="export"]')
        ?.addEventListener("click", () => {
            exportToFile();
        });

    const initial = $navItem.get();
    document
        .querySelector(`[data-nav="${initial}"]`)
        ?.classList.add("is-active");
</script>

<style>
    .nav-item.is-active {
        background: var(--color-accent-subtle);
        color: var(--color-accent);
    }
</style>
