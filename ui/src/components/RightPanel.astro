---

---

<aside
    class="w-[44px] border-l border-border bg-surface flex flex-col items-center py-3 gap-0.5 flex-shrink-0"
>
    <input
        id="backup-import-input"
        type="file"
        accept="application/json,.json"
        class="hidden"
    />

    <button class="icon-btn nav-btn" id="nav-today" title="Heute">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <rect x="3" y="4" width="18" height="18" rx="2"></rect><line
                x1="16"
                y1="2"
                x2="16"
                y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                x1="3"
                y1="10"
                x2="21"
                y2="10"></line>
            <path d="M8 14h8M8 18h5"></path>
        </svg>
    </button>

    <button class="icon-btn nav-btn" id="nav-focus" title="Fokus">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"
            ></circle><circle
                cx="12"
                cy="12"
                r="1.5"
                fill="currentColor"
                stroke="none"></circle>
        </svg>
    </button>

    <button
        class="icon-btn nav-btn"
        id="action-export"
        title="Backup exportieren"
    >
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 3v12"></path><path d="M8 11l4 4 4-4"></path><path
                d="M4 21h16"></path>
        </svg>
    </button>

    <button
        class="icon-btn nav-btn"
        id="action-import"
        title="Backup importieren"
    >
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 21V9"></path><path d="M8 13l4-4 4 4"></path><path
                d="M4 3h16"></path>
        </svg>
    </button>

    <button
        class="icon-btn nav-btn"
        id="action-snapshot"
        title="Snapshot speichern"
    >
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M5 5h14v14H5z"></path><path d="M8 3v4"></path><path
                d="M16 3v4"></path><path d="M5 10h14"></path><path d="M12 13v4"
            ></path><path d="M10 15h4"></path>
        </svg>
    </button>

    <div class="flex-1"></div>

    <button class="icon-btn nav-btn" id="nav-settings" title="Einstellungen">
        <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
            ></path>
        </svg>
    </button>
</aside>

<script>
    import { $navItem } from "../stores/uiStore";
    import {
        runExportWithFeedback,
        runSnapshotWithFeedback,
        restoreFromBackupFile,
    } from "../lib/backupActions";

    function setNav(nav) {
        $navItem.set(nav);
    }

    document
        .getElementById("nav-today")
        ?.addEventListener("click", () => setNav("today"));
    document
        .getElementById("nav-focus")
        ?.addEventListener("click", () => setNav("focus"));
    document
        .getElementById("nav-settings")
        ?.addEventListener("click", () => setNav("settings"));
    document.getElementById("action-export")?.addEventListener("click", () => {
        runExportWithFeedback();
    });
    document
        .getElementById("action-snapshot")
        ?.addEventListener("click", () => {
            runSnapshotWithFeedback();
        });

    const importInput = document.getElementById("backup-import-input");
    document.getElementById("action-import")?.addEventListener("click", () => {
        importInput?.click();
    });
    importInput?.addEventListener("change", async (event) => {
        const file = event.target?.files?.[0];
        if (!file) return;
        await restoreFromBackupFile(file);
        importInput.value = "";
    });

    function syncActive(nav: string) {
        document
            .getElementById("nav-today")
            ?.classList.toggle("is-active", nav === "today");
        document
            .getElementById("nav-focus")
            ?.classList.toggle("is-active", nav === "focus");
        document
            .getElementById("nav-settings")
            ?.classList.toggle("is-active", nav === "settings");
    }
    syncActive($navItem.get());
    $navItem.subscribe(syncActive);
</script>

<style>
    .icon-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: var(--color-text-muted);
        transition:
            background 0.15s,
            color 0.15s;
        cursor: pointer;
        opacity: 0.72;
    }
    .icon-btn:hover {
        background: var(--color-bg);
        color: var(--color-text-secondary);
        opacity: 1;
    }
    .icon-btn.is-active {
        background: var(--color-accent-subtle);
        color: var(--color-accent);
        opacity: 1;
        cursor: default;
    }
</style>
